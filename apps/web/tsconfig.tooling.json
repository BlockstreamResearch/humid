{
	/* The offline developer tooling — the manifest inspector and the format support page —
	   typechecked on its own.

	   It exists because the whole-app typecheck does not pass on a frozen install: two
	   incompatible `csstype` versions are reachable through separate dependency trees and the
	   error surfaces in `src/components/ui/sonner.tsx`, which nothing in this slice touches.
	   That is the dependency convergence the branch repairs later, and until then a gate over
	   the whole app would report it against every change to this tooling and say nothing about
	   the tooling.

	   So this narrows what is *checked*, not what is *read*. `include` names only the tooling's
	   own sources; every UI component, hook and package they import is still followed and
	   typechecked as an import, under exactly the settings `tsconfig.app.json` states. There is
	   no stub, no `any`, no skipped file and no loosened flag here — the only line that is not
	   inherited is which files the program starts from. */
	"extends": "./tsconfig.app.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tooling.tsbuildinfo"
	},
	"include": ["src/app/manifest", "src/app/format", "src/bun-test-env.d.ts"]
}
